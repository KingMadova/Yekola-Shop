SUPABASE_SERVICE_ROLE_KEY=

# À renseigner uniquement après avoir ajouté et vérifié le vrai PDF dans /public.
# Exemple : NEXT_PUBLIC_CATALOG_PDF_PATH=/catalogue-forever.pdf
NEXT_PUBLIC_CATALOG_PDF_PATH=

# Catalogue de secours, uniquement pour les essais locaux.
CATALOG_FALLBACK=
